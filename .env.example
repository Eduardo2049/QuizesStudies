# ─── Banco de Dados ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@host:5432/quiz_study
POSTGRES_PASSWORD=SuaSenhaSeguraPostgres123*
DB_SSLMODE=verify-full  # 'verify-full' (padrão recomendado pela auditoria) ou 'require'
AUTO_MIGRATE=true  # false se as migrations forem executadas via CI/CD no release

# ─── Administrador ───────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SuaSenhaSegura123*

# ─── Servidor ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ─── Segurança ───────────────────────────────────────────────────────────────
COOKIE_SECURE=true
TRUST_PROXY=false
# ALLOWED_ORIGINS=https://meusite.com,https://outro.com

# ─── IA — OpenRouter, só modelos gratuitos (":free") ──────────────────────────
# Chave em https://openrouter.ai/keys. Libere os modelos gratuitos em
# https://openrouter.ai/settings/privacy, senão o OpenRouter recusa os pedidos.
OPENROUTER_API_KEY=sk-or-v1-...
# Preferidos em ordem (ids sem ":free" são ignorados); o servidor também descobre
# sozinho os outros modelos gratuitos disponíveis e usa como reserva.
# OPENROUTER_FREE_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_DISCOVER_FREE_MODELS=true
# Modelos tentados por pedido antes de desistir (cada tentativa conta no limite do OpenRouter)
# OPENROUTER_MAX_ATTEMPTS=4
AI_TOKEN_QUOTA_PER_HOUR=50000
# Teto global de chamadas à IA a cada 24 h (todos os usuários; 0 desliga).
# Modelos gratuitos: 50 pedidos/dia por conta sem créditos comprados; 1.000/dia
# depois de comprar pelo menos US$ 10 uma vez. Sem créditos, use algo como 40.
AI_DAILY_CALL_LIMIT=40

# ─── IA — Google AI Studio (desativado por enquanto) ──────────────────────────
# Para reativar no futuro, veja os blocos comentados em api/utils/config.py e
# _call_openrouter() em api/services/ai_service.py.
# GEMINI_API_KEY=sua-chave-google-ai-studio-aqui
# GEMINI_MODEL=gemini-flash-lite-latest

# ─── Entrar com Google (opcional; vazio = botão escondido) ────────────────────
# Redirect URI a cadastrar no Google Cloud: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Modo convidado (acesso sem conta) ───────────────────────────────────────
# Usos de IA por convidado na janela; 0 desliga a IA para convidados
GUEST_AI_LIMIT=3
# Janela da cota em horas (máximo 24)
GUEST_AI_WINDOW_HOURS=24
# Teto por IP somando todos os convidados (contra renovação apagando cookies)
GUEST_AI_IP_LIMIT=10

# ─── E-mail e Recuperação de Senha (SMTP) ──────────────────────────────────
# Se configurado, os links de redefinição de senha serão enviados por e-mail.
# Se omitido, nenhum e-mail sai: o link vai só para os logs do servidor e, com
# DEBUG=true, aparece na tela de recuperação (ideal para dev). Passo a passo do
# Gmail (senha de app) em docs/CICD_E_DEPLOY.md, seção 7.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASSWORD=sua-senha-de-app-ou-smtp
# SMTP_FROM=Acely <noreply@acely.com.br>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# APP_URL=http://localhost:8000  # URL pública usada no link do e-mail. Em produção: https://acely.com.br
#   Obrigatória fora da Vercel e de localhost (Docker, túnel): sem ela o servidor não envia o link de
#   recuperação nem liga o login com Google, para que um cabeçalho Host forjado não vire o endereço do link.

# ─── Cloudflare Tunnel (opcional) ────────────────────────────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=seu-token-cloudflare-aqui
