# ─── Banco de Dados ──────────────────────────────────────────────────────────
# Qualquer PostgreSQL: Neon, Supabase, Docker local. Passo a passo em docs/BANCO_DE_DADOS.md.
# DATABASE_URL tem prioridade sobre as variáveis que a integração Neon da Vercel cria
# (POSTGRES_URL, DATABASE_URL_UNPOOLED), então você pode cadastrar a sua e trocar de provedor.
# Na Vercel (funções serverless), use a URL COM pooler:
#   Neon: host com "-pooler"; Supabase: Transaction pooler, porta 6543.
DATABASE_URL=postgresql://usuario:senha@host:5432/quiz_study
# Na Vercel com a integração Neon, o nome DATABASE_URL fica travado pela integração.
# Para usar uma URL sua (ex.: com sslmode=verify-full), cadastre ACELY_DATABASE_URL: ela tem
# prioridade sobre todas as outras. ACELY_DATABASE_URL_DIRECT é a versão sem pooler (opcional).
# ACELY_DATABASE_URL=
# Opcional: URL SEM pooler para migrations e scripts (reset_database.py).
# Vazio = usa a DATABASE_URL. Neon: host sem "-pooler"; Supabase: Session pooler, porta 5432.
# DATABASE_URL_DIRECT=
POSTGRES_PASSWORD=SuaSenhaSeguraPostgres123*
# Só vale quando a URL não traz sslmode. 'verify-full' valida o certificado (recomendado).
DB_SSLMODE=verify-full
# Certificado da autoridade para verify-full. Vazio = arquivo do certifi (serve para a Neon).
# Não use "system": o psycopg2-binary não acha os certificados do sistema.
# Supabase: caminho do .crt baixado em Project Settings → Database → SSL.
# DB_SSLROOTCERT=
AUTO_MIGRATE=true  # false se as migrations forem executadas via CI/CD no release

# ─── Administrador ───────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SuaSenhaSegura123*

# ─── Servidor ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ─── Segurança ───────────────────────────────────────────────────────────────
COOKIE_SECURE=true
TRUST_PROXY=false
# ALLOWED_ORIGINS=https://meusite.com,https://outro.com

# ─── IA — OpenRouter, só modelos gratuitos (":free") ──────────────────────────
# Chave em https://openrouter.ai/keys. Libere os modelos gratuitos em
# https://openrouter.ai/settings/privacy, senão o OpenRouter recusa os pedidos.
OPENROUTER_API_KEY=sk-or-v1-...
# Preferidos em ordem (ids sem ":free" são ignorados); o servidor também descobre
# sozinho os outros modelos gratuitos disponíveis e usa como reserva.
# OPENROUTER_FREE_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_DISCOVER_FREE_MODELS=true
# Modelos tentados por pedido antes de desistir (cada tentativa conta no limite do OpenRouter)
# OPENROUTER_MAX_ATTEMPTS=4
# Segundos que um modelo pode ficar sem mandar nada antes de passar ao próximo (5 a 120)
# AI_ATTEMPT_TIMEOUT=20
# Dias que um simulado por tema fica guardado para o mesmo pedido (0 desliga o cache no banco)
# AI_CACHE_TTL_DAYS=7
AI_TOKEN_QUOTA_PER_HOUR=50000
# Pedidos de IA por minuto por usuário/convidado (gerar tema, remix e upload com IA; 0 desliga).
# Conta o pedido da pessoa, não as partes; devolve a vaga quando a IA falha ou o resultado vem pronto.
AI_USER_REQUESTS_PER_MINUTE=10
# Conferência do gabarito por um segundo modelo: account (só contas), all ou off
# AI_CROSS_CHECK=account
# Teto global de chamadas ao provedor a cada 24 h (todos os usuários; 0 desliga).
# Conta CADA chamada: com a OpenAI na frente, uma por parte de 3 questões e outra para conferir
# cada parte (média ~8 por simulado; até 20 num de 30 questões com conferência). O custo em tokens
# quase não muda com as partes. Só com os gratuitos do OpenRouter sem créditos (50/dia), use 40.
AI_DAILY_CALL_LIMIT=3000
#
# Velocidade da geração por tema (meta: até ~10 s). 0 = automático: com a OpenAI na frente,
# partes de 3 questões, até 10 ao mesmo tempo, e cada parte conferida assim que fica pronta;
# só com provedores gratuitos, partes de 5 e até 3 ao mesmo tempo (limites por minuto do Groq).
# AI_PART_SIZE=0
# AI_PARALLEL_PARTS=0
# OpenAI Fast mode: até ~2,5x mais rápido nos modelos aceitos, com preço por token maior.
# Vazio = padrão da conta; valores: fast, priority, default, flex, auto.
# OPENAI_SERVICE_TIER=

# ─── IA — prioridade de provedores (troque a ordem quando quiser) ────────────
# Defina quais provedores usar e em qual ordem de prioridade:
#   - Somente OpenAI (sem depender do OpenRouter): AI_PROVIDERS=openai
#   - OpenAI primeiro com reservas gratuitos:      AI_PROVIDERS=openai,groq,gemini,openrouter
#   - Somente provedores gratuitos:                AI_PROVIDERS=groq,gemini,openrouter
# Provedor sem chave configurada é pulado automaticamente. ATENÇÃO: com a variável definida,
# um provedor que não está na lista nunca é chamado, mesmo com chave (versões antigas deste
# arquivo sugeriam groq,gemini,cerebras,openrouter, sem a OpenAI). Sem a variável, a ordem é
# openai,groq,gemini,cerebras,openrouter. O admin vê a ordem e os avisos em Minha conta.
AI_PROVIDERS=openai,groq,gemini,cerebras,openrouter
#
# OpenAI (https://platform.openai.com/api-keys): precisa de créditos na conta (sem crédito a
# OpenAI responde 429 insufficient_quota e o servidor passa para os gratuitos).
# Aceita OPENAI_API_KEY (ou CODEX_API_KEY), OPENAI_MODELS (ou CODEX_MODELS) e OPENAI_BASE_URL.
# Padrão dos modelos: gpt-6-luna e, de reserva, gpt-4o-mini (desliga em 14/01/2027).
# gpt-5-nano e gpt-5-mini desligam em 11/12/2026 e codex-mini-latest já foi desligado: se a
# Vercel tiver OPENAI_MODELS ou CODEX_MODELS com eles, troque ou apague a variável.
# Organização não verificada na OpenAI não recebe gpt-5/gpt-6 em partes (streaming): o servidor
# percebe e pede a resposta inteira, sem erro para a pessoa.
# OPENAI_API_KEY=sk-...
# OPENAI_MODELS=gpt-6-luna,gpt-4o-mini
# CODEX_API_MODE=auto
#
# Groq (https://console.groq.com/keys): o mais rápido; não usa os dados para treino.
# Grátis por modelo: ~1.000 pedidos/dia, 200 mil tokens/dia, 8 mil tokens/min.
# GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
#
# Google Gemini (https://aistudio.google.com/apikey): sem cartão. No plano gratuito o
# Google usa o conteúdo para melhorar os produtos dele (avisado em /privacidade).
# GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
#
# Cerebras (https://cloud.cerebras.ai): opcional; teste grátis com cartão e contexto curto.
# CEREBRAS_API_KEY=
# CEREBRAS_MODELS=gpt-oss-120b
#
# Orçamento diário POR MODELO (pedidos e tokens; 0 = sem controle). O provedor é pulado
# antes de responder 429. Padrões um pouco abaixo dos limites grátis:
# OPENAI_DAILY_REQUESTS=500      (nome antigo: CODEX_DAILY_REQUESTS)
# OPENAI_DAILY_TOKENS=500000     (nome antigo: CODEX_DAILY_TOKENS)
# GROQ_DAILY_REQUESTS=950
# GROQ_DAILY_TOKENS=190000
# GEMINI_DAILY_REQUESTS=450
# CEREBRAS_DAILY_TOKENS=950000

# ─── Entrar com Google (opcional; vazio = botão escondido) ────────────────────
# Redirect URI a cadastrar no Google Cloud: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Modo convidado (acesso sem conta) ───────────────────────────────────────
# Usos de IA por convidado na janela; 0 desliga a IA para convidados
GUEST_AI_LIMIT=3
# Janela da cota em horas (máximo 24)
GUEST_AI_WINDOW_HOURS=24
# Teto por IP somando todos os convidados (contra renovação apagando cookies)
GUEST_AI_IP_LIMIT=10

# ─── E-mail e Recuperação de Senha (SMTP) ──────────────────────────────────
# Se configurado, os links de redefinição de senha serão enviados por e-mail.
# Se omitido, nenhum e-mail sai: o link vai só para os logs do servidor e, com
# DEBUG=true, aparece na tela de recuperação (ideal para dev). Passo a passo do
# Gmail (senha de app) em docs/CICD_E_DEPLOY.md, seção 7.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASSWORD=sua-senha-de-app-ou-smtp
# SMTP_FROM=Acely <noreply@acely.com.br>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# APP_URL=http://localhost:8000  # URL pública usada no link do e-mail. Em produção: https://acely.com.br

# ─── Entrar com código de 6 dígitos por e-mail ─────────────────────────────
# Usa o mesmo SMTP acima. Sem SMTP_HOST (e sem DEBUG=true), a rota responde 503 e a tela
# sugere Google ou modo convidado. Em DEBUG sem SMTP, o código volta na resposta (só para testes).
# AUTH_CODE_SECRET: chave do HMAC que guarda os códigos no banco. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sem ela, a chave é derivada de ADMIN_PASSWORD.
# AUTH_CODE_SECRET=
# LOGIN_CODE_TTL_MINUTES=10      # validade do código (3 a 60)
# LOGIN_CODE_MAX_ATTEMPTS=5      # palpites errados antes de o código morrer (3 a 10)
# LOGIN_CODE_RESEND_SECONDS=60   # espera entre dois envios para o mesmo e-mail
# LOGIN_CODE_MAX_PER_HOUR=5      # códigos por e-mail por hora
#   Obrigatória fora da Vercel e de localhost (Docker, túnel): sem ela o servidor não envia o link de
#   recuperação nem liga o login com Google, para que um cabeçalho Host forjado não vire o endereço do link.

# ─── Cloudflare Tunnel (opcional) ────────────────────────────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=seu-token-cloudflare-aqui
